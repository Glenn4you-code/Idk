Close.Position = UDim2.new(1,-36,0,10)
Close.Text = "✕"
Close.Font = Enum.Font.GothamBold
Close.TextSize = 16
Close.TextColor3 = Color3.fromRGB(230,230,230)
Close.BackgroundColor3 = Color3.fromRGB(40,40,45)
Instance.new("UICorner", Close).CornerRadius = UDim.new(1,0)

-- ================= CONTENT =================
local Content = Instance.new("Frame", Main)
Content.Position = UDim2.new(0,14,0,52)
Content.Size = UDim2.new(1,-28,1,-64)
Content.BackgroundTransparency = 1
Content.AutomaticSize = Enum.AutomaticSize.Y

local Layout = Instance.new("UIListLayout", Content)
Layout.Padding = UDim.new(0,10)

-- ================= DRAG (FIXED) =================
do
	local dragging, startPos, startInput

	Main.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			startInput = i.Position
			startPos = Main.Position
		end
	end)

	UIS.InputChanged:Connect(function(i)
		if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = i.Position - startInput
			Main.Position = startPos + UDim2.fromOffset(delta.X, delta.Y)
			Shadow.Position = Main.Position
		end
	end)

	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
end

-- ================= OPEN BUTTON =================
local OpenBtn = Instance.new("TextButton", Gui)
OpenBtn.Size = UDim2.fromOffset(50,50)
OpenBtn.Position = UDim2.new(0,20,0.5,-25)
OpenBtn.BackgroundColor3 = Color3.fromRGB(0,0,0)
OpenBtn.Text = "OPEN"
OpenBtn.Font = Enum.Font.GothamBold
OpenBtn.TextSize = 12
OpenBtn.TextColor3 = Color3.new(1,1,1)
OpenBtn.Visible = false
Instance.new("UICorner", OpenBtn).CornerRadius = UDim.new(1,0)

Close.MouseButton1Click:Connect(function()
	Main.Visible = false
	Shadow.Visible = false
	OpenBtn.Visible = true
end)

OpenBtn.MouseButton1Click:Connect(function()
	Main.Visible = true
	Shadow.Visible = true
	OpenBtn.Visible = false
end)

-- ================= API =================
function Library:CreateJudul(text)
	Title.Text = "Glenn4you | "..text
end

function Library:Toggle(text, callback)
	local Row = Instance.new("TextButton", Content)
	Row.Size = UDim2.new(1,0,0,32)
	Row.Text = text.." : OFF"
	Row.Font = Enum.Font.Gotham
	Row.TextSize = 14
	Row.TextColor3 = Color3.new(1,1,1)
	Row.BackgroundColor3 = Color3.fromRGB(40,40,45)
	Instance.new("UICorner", Row)

	local state = false
	Row.MouseButton1Click:Connect(function()
		state = not state
		Row.Text = text.." : "..(state and "ON" or "OFF")
		if callback then callback(state) end
	end)
end

function Library:Button(text, btnText, callback)
	local Row = Instance.new("TextButton", Content)
	Row.Size = UDim2.new(1,0,0,32)
	Row.Text = text.." ["..btnText.."]"
	Row.Font = Enum.Font.Gotham
	Row.TextSize = 14
	Row.TextColor3 = Color3.new(1,1,1)
	Row.BackgroundColor3 = Color3.fromRGB(45,45,50)
	Instance.new("UICorner", Row)

	Row.MouseButton1Click:Connect(function()
		if callback then callback() end
	end)
end

function Library:Dropdown(text, list, callback)
	local open = false

	local Row = Instance.new("TextButton", Content)
	Row.Size = UDim2.new(1,0,0,32)
	Row.Text = text.." ▼"
	Row.Font = Enum.Font.Gotham
	Row.TextSize = 14
	Row.TextColor3 = Color3.new(1,1,1)
	Row.BackgroundColor3 = Color3.fromRGB(45,45,50)
	Instance.new("UICorner", Row)

	local Drop = Instance.new("Frame", Content)
	Drop.Size = UDim2.new(1,0,0,0)
	Drop.BackgroundTransparency = 1
	Drop.ClipsDescendants = true

	local DLayout = Instance.new("UIListLayout", Drop)
	DLayout.Padding = UDim.new(0,6)

	for _,v in ipairs(list) do
		local Opt = Instance.new("TextButton", Drop)
		Opt.Size = UDim2.new(1,0,0,28)
		Opt.Text = v
		Opt.Font = Enum.Font.Gotham
		Opt.TextSize = 13
		Opt.TextColor3 = Color3.new(1,1,1)
		Opt.BackgroundColor3 = Color3.fromRGB(35,35,40)
		Instance.new("UICorner", Opt)

		Opt.MouseButton1Click:Connect(function()
			open = false
			Drop.Size = UDim2.new(1,0,0,0)
			Row.Text = text.." : "..v
			if callback then callback(v) end
		end)
	end

	Row.MouseButton1Click:Connect(function()
		open = not open
		Drop.Size = open and UDim2.new(1,0,0,#list*34) or UDim2.new(1,0,0,0)
	end)
end

return Library
