local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/bloodball/-back-ups-for-libs/main/wizard"))()

local PhantomForcesWindow = Library:NewWindow("Aimbot")

local KillingCheats = PhantomForcesWindow:NewSection("Main")

local Cam = workspace.CurrentCamera

local aimbotEnabled = false
local teamCheckEnabled = false
local wallCheckEnabled = false
local aimStrength = 0.01 -- Default strength (disesuaikan menjadi lebih rendah)

function lookAt(eye, target, strength)
    local direction = (target - eye).unit
    local newCFrame = CFrame.new(eye, eye + direction * strength)
    Cam.CFrame = newCFrame
end

function isVisible(targetPart)
    local origin = Cam.CFrame.p
    local target = targetPart.Position
    local ray = Ray.new(origin, (target - origin).unit * 5000)
    local hit, position = workspace:FindPartOnRayWithIgnoreList(ray, {game.Players.LocalPlayer.Character, Cam})
    
    if hit then
        return hit:IsDescendantOf(targetPart.Parent)
    end
    return false
end

function isAlive(player)
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end

function getClosestPlayerToCursor(trg_part)
    local nearest = nil
    local last = math.huge
    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= game.Players.LocalPlayer and v.Character and v.Character:FindFirstChild(trg_part) and isAlive(v) then
            if not teamCheckEnabled or (teamCheckEnabled and v.Team ~= game.Players.LocalPlayer.Team) then
                local ePos, vissss = workspace.CurrentCamera:WorldToViewportPoint(v.Character[trg_part].Position)
                local AccPos = Vector2.new(ePos.x, ePos.y)
                local mousePos = Vector2.new(workspace.CurrentCamera.ViewportSize.x / 2, workspace.CurrentCamera.ViewportSize.y / 2)
                local distance = (AccPos - mousePos).magnitude
                if distance < last and vissss and aimbotEnabled and distance < 400 then
                    if not wallCheckEnabled or (wallCheckEnabled and isVisible(v.Character[trg_part])) then
                        last = distance
                        nearest = v
                    end
                end
            end
        end
    end
    return nearest
end

function EnableAimbot()
    aimbotEnabled = true
end

function DisableAimbot()
    aimbotEnabled = false
end

local function CreateAimbotToggle()
    KillingCheats:CreateToggle("Aimbot", function(value)
        if value then
            EnableAimbot()
        else
            DisableAimbot()
        end
    end)
end

local function CreateTeamCheckToggle()
    KillingCheats:CreateToggle("Team Check", function(value)
        teamCheckEnabled = value
    end)
end

local function CreateWallCheckToggle()
    KillingCheats:CreateToggle("Wall Check", function(value)
        wallCheckEnabled = value
    end)
end

game:GetService("RunService").RenderStepped:Connect(function()
    if aimbotEnabled then
        local closest = getClosestPlayerToCursor("Head")
        if closest and closest.Character and closest.Character:FindFirstChild("Head") then
            lookAt(Cam.CFrame.p, closest.Character.Head.Position, aimStrength)
        end
    end
end)

CreateAimbotToggle()
CreateTeamCheckToggle()
CreateWallCheckToggle()

local espConfig = {
    Color = Color3.fromHSV(0.577294647693634, 0.9159291982650757, 0.886274516582489),
    TeamColors = true,
}

local connections = {}
local outlines = {}
local playerOutlines = {}

local function GetTeamColor(player)
    if player.Team and espConfig.TeamColors then
        return player.TeamColor.Color
    else
        return espConfig.Color
    end
end

local function CreateOutlineESP(player)
    if playerOutlines[player] then return end

    local outlineTop = Drawing.new("Line")
    outlineTop.Visible = false
    outlineTop.Thickness = 1

    local outlineBottom = Drawing.new("Line")
    outlineBottom.Visible = false
    outlineBottom.Thickness = 1

    local outlineLeft = Drawing.new("Line")
    outlineLeft.Visible = false
    outlineLeft.Thickness = 1

    local outlineRight = Drawing.new("Line")
    outlineRight.Visible = false
    outlineRight.Thickness = 1

    local function UpdateOutlineESP()
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local position, onScreen = game:GetService("Workspace").CurrentCamera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
            if onScreen then
                local scale = math.clamp(2 / position.Z, 0, 2)

                local width = 200 * scale
                local height = 300 * scale

                outlineTop.From = Vector2.new(position.X - width / 2, position.Y - height / 2)
                outlineTop.To = Vector2.new(position.X + width / 2, position.Y - height / 2)
                outlineTop.Visible = true

                outlineBottom.From = Vector2.new(position.X - width / 2, position.Y + height / 2)
                outlineBottom.To = Vector2.new(position.X + width / 2, position.Y + height / 2)
                outlineBottom.Visible = true

                outlineLeft.From = Vector2.new(position.X - width / 2, position.Y - height / 2)
                outlineLeft.To = Vector2.new(position.X - width / 2, position.Y + height / 2)
                outlineLeft.Visible = true

                outlineRight.From = Vector2.new(position.X + width / 2, position.Y - height / 2)
                outlineRight.To = Vector2.new(position.X + width / 2, position.Y + height / 2)
                outlineRight.Visible = true

                local teamColor = GetTeamColor(player)
                if player.Team == nil or not espConfig.TeamColors then
                    local hue = tick() % 5 / 5
                    teamColor = Color3.fromHSV(hue, 1, 1)
                end

                outlineTop.Color = teamColor
                outlineBottom.Color = teamColor
                outlineLeft.Color = teamColor
                outlineRight.Color = teamColor
            else
                outlineTop.Visible = false
                outlineBottom.Visible = false
                outlineLeft.Visible = false
                outlineRight.Visible = false
            end
        else
            outlineTop.Visible = false
            outlineBottom.Visible = false
            outlineLeft.Visible = false
            outlineRight.Visible = false
        end
    end

    table.insert(connections, game:GetService("RunService").RenderStepped:Connect(UpdateOutlineESP))
    table.insert(outlines, outlineTop)
    table.insert(outlines, outlineBottom)
    table.insert(outlines, outlineLeft)
    table.insert(outlines, outlineRight)
    
    playerOutlines[player] = true
end

local function SetupOutlineESP(player)
    CreateOutlineESP(player)
    player.CharacterAdded:Connect(function()
        CreateOutlineESP(player)
    end)
end

local function EnableOutlineESP()
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= game.Players.LocalPlayer then
            SetupOutlineESP(player)
        end
    end

    table.insert(connections, game.Players.PlayerAdded:Connect(function(player)
        SetupOutlineESP(player)
    end))

    table.insert(connections, game.Players.PlayerRemoving:Connect(function(player)
        if playerOutlines[player] then
            playerOutlines[player] = nil
        end
    end))
end

local function DisableOutlineESP()
    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
    connections = {}

    for _, outline in ipairs(outlines) do
        outline.Visible = false
        outline:Remove()
    end
    outlines = {}
    playerOutlines = {}
end

local ESP = {
    Enable = EnableOutlineESP,
    Disable = DisableOutlineESP
}

KillingCheats:CreateToggle("Esp Player", function(value)
    if value then
        ESP.Enable()
    else
        ESP.Disable()
    end
end)

local KillingCheats = PhantomForcesWindow:NewSection("Glenn4You")
